# Criar arquivo .env com:
REACT_APP_API_URL=http://localhost:8000
DANGEROUSLY_DISABLE_HOST_CHECK=true
ROBO_ROOT_PATH=C:\Users\Meu Computador\Desktop\Robô-comissões\robo-comissoes

# === Performance: reduzir tempo de compilação do webpack em dev ===
# Desabilita geração de source maps (principal causa de lentidão: ~7MB de .map)
GENERATE_SOURCEMAP=false
# Desabilita plugin ESLint embutido no webpack (poupa ~20-40s de análise estática)
DISABLE_ESLINT_PLUGIN=true